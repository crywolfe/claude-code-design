{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-bash.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*chrome-devtools.*__(navigate_page|new_page|evaluate_script)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-browser.py"
          }
        ]
      }
    ]
  }
}
